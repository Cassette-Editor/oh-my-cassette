{
  "name": "oh-my-cassette",
  "version": "0.5.0",
  "description": "Edit video with the Cassette agent from Claude Code: import local media, send editing turns, undo or revert them, export.",
  "author": {
    "name": "Oh My Cassette contributors",
    "url": "https://github.com/Cassette-Editor/oh-my-cassette"
  },
  "homepage": "https://github.com/Cassette-Editor/oh-my-cassette",
  "repository": "https://github.com/Cassette-Editor/oh-my-cassette",
  "license": "MIT",
  "keywords": ["cassette", "video-editing", "media", "mcp"],
  "mcpServers": "./.mcp.json",
  "userConfig": {
    "mcp_url": {
      "type": "string",
      "title": "Cassette MCP URL",
      "description": "The Cassette MCP service endpoint.",
      "default": "http://127.0.0.1:8790/mcp"
    },
    "auth_token": {
      "type": "string",
      "title": "Cassette access token",
      "description": "Bearer token for the Cassette MCP service.",
      "sensitive": true,
      "required": true
    }
  }
}
