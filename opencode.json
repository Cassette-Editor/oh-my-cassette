{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cassette": {
      "type": "local",
      "command": ["uvx", "oh-my-cassette==0.5.0"],
      "environment": {
        "CASSETTE_MCP_URL": "http://127.0.0.1:8790/mcp",
        "CASSETTE_AUTH_TOKEN": "{env:CASSETTE_AUTH_TOKEN}"
      },
      "timeout": 600000,
      "enabled": true
    }
  }
}
