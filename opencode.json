{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cassette": {
      "type": "local",
      "command": ["uvx", "oh-my-cassette==0.5.0"],
      "environment": {
        "CASSETTE_API_URL": "http://127.0.0.1:8787",
        "CASSETTE_WEB_URL": "http://127.0.0.1:8080"
      },
      "timeout": 3600000,
      "enabled": true
    }
  }
}
