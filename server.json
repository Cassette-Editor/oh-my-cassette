{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Cassette-Editor/oh-my-cassette",
  "title": "Oh My Cassette",
  "description": "Video editing through the Cassette agent: import media, edit by chat turn, read the timeline, export",
  "version": "0.5.0",
  "websiteUrl": "https://cassette-editor.github.io/oh-my-cassette/",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/Cassette-Editor/oh-my-cassette/main/assets/logo-400.png",
      "mimeType": "image/png",
      "sizes": [
        "400x400"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/Cassette-Editor/oh-my-cassette",
    "source": "github",
    "id": "1265161922"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "oh-my-cassette",
      "version": "0.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CASSETTE_API_URL",
          "description": "Cassette-Editor backend base URL",
          "isRequired": false,
          "default": "http://127.0.0.1:8787"
        },
        {
          "name": "CASSETTE_WEB_URL",
          "description": "Cassette web editor base URL",
          "isRequired": false,
          "default": "http://127.0.0.1:8080"
        },
        {
          "name": "CASSETTE_AUTH_TOKEN",
          "description": "Bearer token for a deployed backend",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
