{
  "mcpServers": {
    "cassette": {
      "command": "uvx",
      "args": ["oh-my-cassette==0.5.0"],
      "env": {
        "CASSETTE_API_URL": "${user_config.api_url}",
        "CASSETTE_WEB_URL": "${user_config.web_url}",
        "CASSETTE_AUTH_TOKEN": "${user_config.auth_token}"
      },
      "timeout": 3600000
    }
  }
}
